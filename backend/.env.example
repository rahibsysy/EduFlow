APP_ENV=local
APP_DEBUG=true
APP_NAME="OneCore"
APP_URL=http://localhost
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=salma_project
DB_USER=root
DB_PASS=root
# Generate with: php -r "echo base64_encode(random_bytes(48)), PHP_EOL;"
JWT_SECRET=GENERATE_A_BASE64_SECRET_BEFORE_STARTING
JWT_TTL=86400

# Initial setup is disabled unless explicitly enabled for a new instance.
INITIAL_SETUP_ENABLED=false
# Generate a distinct provisioning secret; never commit backend/.env.
INITIAL_SETUP_SECRET=GENERATE_A_DIFFERENT_BASE64_SECRET_BEFORE_STARTING
# Mandatory in production. Comma-separated exact source IPs or CIDRs.
INITIAL_SETUP_ALLOWED_IPS=
